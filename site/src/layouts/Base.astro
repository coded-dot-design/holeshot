---
// Every page: a Board UI root (<html class="bui">) wearing the Fizlet kit's tokens; the theme is
// remembered (localStorage "dom-virus:theme", the key the saved choice already lives under), dark by default.
// The header is about the game only (its sections, the theme, PLAY); the links out live in the footer. PLAY opens
// the game in a new tab, so the game page is the root of its own history. The game page (`app`) is
// self-contained: no header, no footer, no links back to the site or out (its controls live in the game's
// settings); a bookmark of it is the game.
import '@fzlt/core/ui/board-ui.css';
import '../styles/site.css';
import { VERSION, REPO, FIZLET_URL, base } from '../site';
import Wordmark from '../components/Wordmark.astro';
const { title, description, page = 'home', app = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="bui" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={app ? "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" : "width=device-width, initial-scale=1, viewport-fit=cover"} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d0b1c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(base('shots/og.jpg'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={base('icon.svg')} type="image/svg+xml" />
    <!-- Add to Home Screen: launches /play/ full screen (manifest), with its own icon on iOS. -->
    <link rel="manifest" href={base('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={base('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Holeshot" />
    <script is:inline>
      try {
        var t = localStorage.getItem("dom-virus:theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body data-page={page} data-app={app ? "" : undefined}>
    {!app && <a class="skip" href="#main">Skip to content</a>}
    {!app && <header class="site-head" id="site-head">
      <div class="wrap">
        <a class="brand" href={base()} aria-label="Holeshot home">
          <img src={base('icon.svg')} alt="" width="36" height="36" />
          <span><Wordmark id="hs-wm-head" class="brand-mark" label="HOLESHOT" /><small>V{VERSION} · BY DAVID COOLEY</small></span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a href={base('#how')}>How to play</a>
          <a href={base('#controls')}>Controls</a>
          <a href={base('#modes')}>Ways to ride</a>
          <a href={base('#garage')}>Garage</a>
          <a href={base('#brand')}>Brand</a>
        </nav>
        <div class="head-keys">
          <button class="bui-key bui-icon-key" type="button" data-theme-toggle aria-label="Switch light or dark"><span class="theme-dark" aria-hidden="true">☾</span><span class="theme-light" aria-hidden="true">☀</span></button>
          <a class="bui-key bui-arcade bui-go play-key" href={base('play/')} target="_blank" rel="noopener">▶ Play</a>
        </div>
      </div>
    </header>}
    <main id="main"><slot /></main>
    {!app && <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <a class="brand" href={base()} aria-label="Holeshot home"><img src={base('icon.svg')} alt="" width="36" height="36" loading="lazy" /><span><Wordmark id="hs-wm-foot" class="brand-mark" /><small>V{VERSION} · BY DAVID COOLEY</small></span></a>
          <p>A game by <a href="https://fizlet.com/people/david-cooley/">David Cooley</a>. Free in your browser.</p>
        </div>
        <nav class="foot-col" aria-label="The game">
          <p class="meta">THE GAME</p>
          <a href={base('play/')} target="_blank" rel="noopener">Play</a>
          <a href={base('#how')}>How to play</a>
          <a href={base('#controls')}>Controls</a>
          <a href={base('#modes')}>Ways to ride</a>
          <a href={base('#garage')}>Garage</a>
          <a href={base('#brand')}>Brand kit</a>
        </nav>
        <nav class="foot-col" aria-label="Elsewhere">
          <p class="meta">ELSEWHERE</p>
          <a href={FIZLET_URL}>Built on Fizlet ↗</a>
          <a href={REPO}>Source on GitHub (MIT) ↗</a>
          <a href="https://fizlet.com/people/david-cooley/">David Cooley ↗</a>
        </nav>
      </div>
    </footer>}
    <script>
      import { toggleTheme } from "../theme";
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", toggleTheme);
    </script>
  </body>
</html>
