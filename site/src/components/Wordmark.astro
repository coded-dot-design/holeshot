---
// The HOLESHOT wordmark (the owner's final art, L1): lime letters, a dark rim, a pink drop, a white
// glint, skewed. One letter path drawn five times. `tab` adds the cyan "BY DAVID COOLEY" tab (the
// lockup). `id` keeps the path's id unique when a page shows the mark twice (header and hero).
// Decorative by default (aria-hidden); pass `label` to make it an image with that name.
const { tab = false, id = 'hs-wm', label, class: cls } = Astro.props;
const D = 'M24.0 22.0L24.0 88.0M68.0 22.0L68.0 88.0M24.0 55.0L68.0 55.0M95.0 22.0L139.0 22.0L139.0 88.0L95.0 88.0L95.0 22.0M166.0 22.0L166.0 88.0L210.0 88.0M281.0 22.0L237.0 22.0L237.0 88.0L281.0 88.0M237.0 55.0L272.2 55.0M352.0 22.0L308.0 22.0L308.0 55.0L352.0 55.0L352.0 88.0L308.0 88.0M379.0 22.0L379.0 88.0M423.0 22.0L423.0 88.0M379.0 55.0L423.0 55.0M450.0 22.0L494.0 22.0L494.0 88.0L450.0 88.0L450.0 22.0M521.0 22.0L565.0 22.0M543.0 22.0L543.0 88.0';
