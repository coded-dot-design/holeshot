// Hard shadows fall straight down (Fizlet): each layer's offset is applied outside the skew.
const h = tab ? 185 : 132;
---
<svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${tab ? 629 : 625} ${h}`} width={tab ? 629 : 625} height={h} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  <defs><path id={id} d={D} fill="none" stroke-linecap="square" stroke-linejoin="bevel" /></defs>
  {[[13, '#0b0a14', 32, 1], [9, '#ff4fa8', 22, 1], [0, '#0b0a14', 32, 1], [0, '#b6f23a', 20, 1], [-4, '#fff', 5, .55]].map(([dy, c, w, o]) => (
    <g transform={`translate(0 ${dy})`}><g transform="skewX(-11) translate(23.94 0)"><use href={`#${id}`} stroke={c} stroke-width={w} opacity={o} /></g></g>
  ))}
  {tab && <g transform="translate(0 5.88)"><rect x="226.8" y="112" width="382.2" height="48.72" rx="5.04" fill="#0b0a14" transform="rotate(-3 417.9 136.36)" /></g>}
  {tab && <g transform="rotate(-3 417.9 136.36)">
    <rect x="226.8" y="112" width="382.2" height="48.72" rx="5.04" fill="#22e6ff" stroke="#0b0a14" stroke-width="4.2" />
    <path d={TAB} fill="none" stroke="#0b0a14" stroke-width="3.57" stroke-linecap="square" stroke-linejoin="miter" />
  </g>}
</svg>
