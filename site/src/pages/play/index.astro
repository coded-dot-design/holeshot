---
// Holeshot, the game: the stage fills the screen (the header tucked away behind a handle). ?mode=<id> starts that event at
// once (once the first-run setup is done); ?mode=online&room=N&code=… opens the online room card and
// joins that room (the code is taken out of the address bar first).
import Base from '../../layouts/Base.astro';
import { ROOMS } from '../../site';
const description = 'Play Holeshot: pick your one starter bike, then race, free ride, fly in Big Air and wheelie through the city, alone or online with up to four. Earn credits, wear parts, rebuild and mod in the garage.';
---
<Base title="Play Holeshot" description={description} page="play" app>
  <Fragment slot="head">
    <!-- An invite code in a link (?code=) is taken out of the address bar before anything else loads. -->
    <meta name="referrer" content="no-referrer" />
    <script is:inline>
      (function () {
        var u = new URL(location.href), p = u.searchParams, c = p.get("code");
        if (!p.has("code")) return;
        p.delete("code");
        history.replaceState(history.state, "", u.pathname + u.search + u.hash);
        if (c) window.__holeshotInvite = c;
      })();
    </script>
  </Fragment>
  <section class="play-stage" aria-labelledby="play-title">
    <h1 id="play-title" class="sr">Play Holeshot</h1>
    <div id="game" class="play-host" data-rooms={ROOMS}></div>
  </section>
  <aside class="pwa-tip" hidden aria-label="Add Holeshot to your Home Screen">
    <p><b>For the best ride, add HOLESHOT to your Home Screen</b><span class="pwa-how"></span></p>
    <button type="button" class="bui-key bui-go pwa-install" hidden>INSTALL</button>
    <button type="button" class="bui-key pwa-x" aria-label="Dismiss the tip">✕</button>
  </aside>
</Base>

<script>
  import { createHoleshot, MODES } from "../../../../dist/holeshot.mjs";
  import { toggleTheme } from "../../theme";
  const host = document.getElementById("game")!;
  const game = createHoleshot({ host, rooms: host.dataset.rooms, onTheme: toggleTheme });
  const want = new URLSearchParams(location.search).get("mode");
  if (want && MODES.some((m: { id: string }) => m.id === want) && game.profile.bikes.length) game.start(want);
  (window as unknown as { game: unknown }).game = game;

  // A phone in landscape in a browser tab: a one-time tip to add the game to the Home Screen (it then
  // launches full screen, no browser bars). Platform-detected how-to; never on desktop, never once it
  // is installed; remembered per browser once shown.
  const TIP = "holeshot:pwa-tip", tip = document.querySelector<HTMLElement>(".pwa-tip")!;
  const how = tip.querySelector<HTMLElement>(".pwa-how")!, inst = tip.querySelector<HTMLButtonElement>(".pwa-install")!;
  const nav = navigator as Navigator & { standalone?: boolean };
  const ios = /iPhone|iPad|iPod/.test(nav.userAgent) || (nav.platform === "MacIntel" && nav.maxTouchPoints > 1);
  how.textContent = ios ? "Tap Share, then Add to Home Screen." : "Open the browser menu ⋮, then Install app (or Add to Home screen).";
  const installed = () => nav.standalone === true || matchMedia("(display-mode: fullscreen), (display-mode: standalone)").matches;
  const seen = () => { try { return localStorage.getItem(TIP) === "1"; } catch { return false; } };
  const land = matchMedia("(pointer: coarse) and (orientation: landscape)");
  let deferred: (Event & { prompt(): Promise<void> }) | null = null;
  addEventListener("beforeinstallprompt", (e) => { e.preventDefault(); deferred = e as typeof deferred; inst.hidden = false; });
  const maybe = () => {
    if (!tip.hidden || !land.matches || installed() || seen()) return;
    tip.hidden = false;
    try { localStorage.setItem(TIP, "1"); } catch { /* private mode: it may show again */ }
  };
  inst.addEventListener("click", () => { deferred?.prompt(); tip.hidden = true; });
  tip.querySelector(".pwa-x")!.addEventListener("click", () => (tip.hidden = true));
  land.addEventListener("change", maybe);
  maybe();
</script>
