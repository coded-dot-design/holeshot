---
// Holeshot, the landing page. The hero is the brand: the lockup (in the h1), the hook, PLAY and the
// box-art cover on a sunset like the cover's. Below it, the game itself: a race on the autopilot in
// the chase view, started when it scrolls near; reduced motion shows a still poster that links to /play/.
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { base, GZIP, FIZLET, REPO } from '../site';
import { CLASSES, MODELS, STARTERS, makerOf } from '../../../src/data/roster.ts';
import { MODES } from '../../../src/modes/index.ts';
const description = 'Holeshot is a dirt bike game on a tabletop: one bike and a garage, races against rivals, a race series on a new track every round, five free-ride maps, Endless (the dunes, a quarry, woods and a night park that never end), a Big Air show and Endless Wheelie City (an open world of roads, towns and fields that never ends). Earn credits, wear out tyres and top ends, rebuild, mod and paint. Free in the browser, by David Cooley, built on Fizlet.';
const kb = (GZIP / 1024).toFixed(1);
const steps = [
  ['PICK YOUR BIKE', 'One bike to start: a peaky 2-stroke, a torquey 4-stroke, a light e-bike or an electric dirt bike. Paint it, number it, pick your jersey. That bike rides every event.'],
  ['RIDE IT', 'Space is the gas, K the brake, W and S your weight (back lifts the front; in the air it pitches the bike), A and D steer; gas and brake together pop a wheelie. On a phone: the stick leans and steers, and one throttle rocker under the right thumb: slide up for gas, down for brake, the middle for both, without lifting. Overshot something? Stopped with no gas, hold W or S (the stick forward or back) and the rider puts a foot down and walks the bike out, backwards too.'],
  ['EARN', 'Races and series rounds pay by place, Big Air by the judges, Endless Wheelie City by points (hold a wheelie past 12 o\'clock for a ×10 hand drag; stop and the neon patrol tickets you), Free Ride a little for saddle time. Crash and you tumble, get back up, and keep riding.'],
  ['WRENCH', 'Every lap wears the bike: tyres lose grip, a 2-stroke\'s top end loses pull, seals blow and it cases sooner. Buy new tyres, rebuild the motor, add mods, change the paint and the kit.'],
];
const classes = Object.values(CLASSES).map((c) => ({ ...c, models: MODELS.filter((m) => m.cls === c.id), starter: STARTERS.find((m) => m.cls === c.id) }));
const words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
const palette = [['Logo lime', '#B6F23A'], ['Drop pink', '#FF4FA8'], ['Credit cyan', '#22E6FF'], ['Sun yellow', '#FFD166'], ['Stripe pink', '#E23D8A'], ['Dusk purple', '#3A1D6E'], ['Night navy', '#1A1038'], ['Ink', '#0B0A14']];
const bricks = ['kernel', 'diorama', 'terrain', 'drive', 'input', 'pad', 'sound', 'ui'];
---
<Base title="Holeshot · one bike, every kind of dirt" description={description}>
  <section class="dt-hero" aria-labelledby="dt-title">
    <div class="wrap hero-grid">
      <div class="dt-copy">
        <p class="eyebrow"><span class="dot"></span> A FIZLET GAME · BY DAVID COOLEY</p>
        <h1 id="dt-title"><span class="sr">Holeshot.</span><Wordmark tab id="hs-wm-hero" class="hero-lockup" /><em>One bike. Every kind of dirt.</em></h1>
        <p class="lead">A dirt bike game on a tabletop. Pick one bike, race it, fly it, wheelie it through town, and keep it alive in the garage: tyres, rebuilds, mods and paint, paid for with what you win.</p>
        <div class="dt-ctas">
          <a class="bui-key bui-sticker-key bui-call start-key" href={base('play/')}><b>PLAY</b><span>free · in your browser</span></a>
          <a class="dt-watch" href="#race">or watch a race ↓</a>
        </div>
      </div>
      <a class="hero-cover" href={base('play/')} tabindex="-1" aria-hidden="true"><span class="hero-sun"></span><img src={base('brand/holeshot-cover.svg')} alt="" width="800" height="1200" fetchpriority="high" decoding="async" /></a>
    </div>
  </section>

  <section class="demo-band" id="race" aria-labelledby="race-title">
    <div class="wrap demo-head">
      <p class="eyebrow"><span class="dot"></span> LIVE · THE REAL GAME, ON AUTOPILOT</p>
      <h2 id="race-title">Watch a race.</h2>
    </div>
    <div class="demo-frame">
      <div class="dt-stage" id="dt-hero" aria-label="Holeshot demo race"></div>
      <a class="dt-poster" href={base('play/')} hidden><img src={base('shots/hero.jpg')} alt="Holeshot: four dirt bikes racing at night on a neon-edged motocross track on a tabletop" width="1600" height="900" loading="lazy" /></a>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow"><span class="index">01</span> HOW TO PLAY</p>
      <h2>Ride it, earn it, wrench it.</h2>
      <ol class="cards">
        {steps.map(([k, b], i) => <li class="panel"><span class="n">0{i + 1}</span><h3>{k}</h3><p>{b}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="modes">
    <div class="wrap">
      <p class="eyebrow"><span class="index">02</span> THE EVENTS</p>
      <h2>{['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'][MODES.length]} ways to ride.</h2>
      <ol class="modes">
        {MODES.map((m) => (
          <li class="panel">
            <h3>{m.name}</h3>
            <p>{m.blurb}</p>
            <p class="meta">{m.maps.length > 1 ? `${m.maps.length} maps` : m.maps[0]!.name}</p>
            <a class="bui-key bui-arcade bui-sys" href={base(`play/?mode=${m.id}`)}>Ride it</a>
          </li>
        ))}
      </ol>
      <p class="soon">And the SERIES: championships of four to six rounds, a new generated track every round, rivals and a points table.</p>
    </div>
  </section>

  <section class="section" id="garage">
    <div class="wrap">
      <p class="eyebrow"><span class="index">03</span> THE GARAGE</p>
      <h2>{words[new Set(MODELS.map((m) => makerOf(m).name)).size]} makers. {MODELS.length} bikes. Room for three.</h2>
      <ul class="cards">
        {classes.map((c) => <li class="panel"><p class="meta">{c.name}</p><h3>{c.maker}</h3><p>{c.motto}</p><p class="meta">{c.starter ? `Starter: ${c.starter.name} · ` : 'In the showroom: '}{c.models.map((m) => m.name).join(' · ')}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="fizlet">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><span class="index">04</span> BUILT ON FIZLET</p>
        <h2>No libraries. {kb} KB.</h2>
        <p>Holeshot is built on <a href="https://fizlet.com/">Fizlet</a>, the micro animation and game engine for the DOM, and nothing else: no framework, no 3D library, no images in the game. The tracks, the bikes and the riders are drawn by Fizlet's bricks on one canvas.</p>
        <p>The whole game, its Fizlet bricks and its Board UI styles: <b>{GZIP.toLocaleString('en-US')} bytes gzip</b> (measured at build, Fizlet {FIZLET}).</p>
        <ul class="bricks">{bricks.map((b) => <li><code>@fzlt/core/{b}</code></li>)}</ul>
      </div>
      <div class="panel lit by">
        <p class="eyebrow"><b>BY DAVID COOLEY</b></p>
        <p>Made by teen game creator <a href="https://fizlet.com/people/david-cooley/">David Cooley</a>, who loves doing wheelies on his gas and electric bikes.</p>
        <h3>It started as three tiny games.</h3>
        <p>Holeshot grew out of three pieces in Fizlet's Daily: Moto Track, Big Air and Wheelie City. They shared one bike; now they share one garage.</p>
        <p><a href={REPO}>Source on GitHub (MIT)</a></p>
        <a class="bui-key bui-arcade bui-go" href={base('play/')}>▶ Play Holeshot</a>
      </div>
    </div>
  </section>

  <section class="section" id="brand" aria-labelledby="brand-title">
    <div class="wrap">
      <p class="eyebrow"><span class="index">05</span> THE BRAND</p>
      <h2 id="brand-title">The Holeshot kit.</h2>
      <p class="brand-credit">Logo, icon and cover art by <a href="https://fizlet.com/people/david-cooley/">David Cooley</a>. Every credited surface says <b>by David Cooley</b>.</p>
      <div class="brand-grid">
        <figure class="panel brand-cover">
          <img src={base('brand/holeshot-cover.svg')} alt="The Holeshot cover: three riders launching off sunset dunes under a striped sun, the HOLESHOT lockup at the top" width="800" height="1200" loading="lazy" decoding="async" />
          <figcaption><b>Cover art</b> <span>800 × 1200 · 2:3</span><span class="dl"><a href={base('brand/holeshot-cover.svg')} download>SVG</a><a href={base('brand/holeshot-cover.png')} download>PNG</a></span></figcaption>
        </figure>
        <div class="brand-side">
          <figure class="panel brand-logo">
            <div class="brand-tiles">
              <div class="brand-tile on-dark"><img src={base('brand/holeshot-lockup.svg')} alt="The HOLESHOT lockup on dark" width="625" height="169" loading="lazy" decoding="async" /></div>
              <div class="brand-tile on-light"><img src={base('brand/holeshot-lockup.svg')} alt="The HOLESHOT lockup on light" width="625" height="169" loading="lazy" decoding="async" /></div>
            </div>
            <figcaption><b>Logo · L1 lockup</b> <span>lime letters, pink drop, ink outline; the credit on the cyan tab</span><span class="dl"><a href={base('brand/holeshot-lockup.svg')} download>Lockup SVG</a><a href={base('brand/holeshot-wordmark.svg')} download>Wordmark SVG</a></span></figcaption>
          </figure>
          <figure class="panel brand-icon">
            <img src={base('brand/holeshot-icon.svg')} alt="The Holeshot app icon: a rider on a wheelie against a setting sun" width="96" height="96" loading="lazy" decoding="async" />
            <figcaption><b>App icon</b> <span>the favicon and the Home Screen icon</span><span class="dl"><a href={base('brand/holeshot-icon.svg')} download>SVG</a><a href={base('brand/holeshot-icon-512.png')} download>PNG 512</a></span></figcaption>
          </figure>
          <div class="panel brand-palette">
            <p class="meta">Palette</p>
            <ul>
              {palette.map(([name, hex]) => <li><span class="sw" style={`background:${hex}`}></span><b>{name}</b><code>{hex}</code></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const host = document.getElementById("dt-hero")!;
  const poster = document.querySelector<HTMLElement>(".dt-poster")!;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) poster.hidden = false;
  else {
    // The race starts when its band comes near the screen, so the brand hero paints first.
    // The game's module loads then too (a dynamic import: nothing of it on the first paint).
    const io = new IntersectionObserver(async (es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const { createHoleshot } = await import("../../../dist/holeshot.mjs");
      (window as unknown as { hero: unknown }).hero = createHoleshot({ host, attract: true, sound: false });
      // The demo rides itself: no touch controls (the pad, the throttle rocker and its hint) over it.
      const style = document.createElement("style");
      style.textContent = ".ba-pad,.hs-rocker{display:none!important}";
      host.querySelector("[data-fizlet-host]")?.shadowRoot?.append(style);
    }, { rootMargin: "0px" });
    io.observe(host);
  }
</script>
